{
  "expo": {
    "name": "ApkaStore",
    "slug": "apkastore",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#059669"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.ico",
      "name": "ApkaStore",
      "shortName": "ApkaStore",
      "themeColor": "#059669",
      "backgroundColor": "#F8FAFC",
      "display": "standalone",
      "scope": "/",
      "startUrl": "/"
    }
  }
}
